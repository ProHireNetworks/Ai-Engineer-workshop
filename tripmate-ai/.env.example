# ==============================================================================
# TripMate AI - Environment Configuration Example
# Duplicate this file as .env and update values for your environment.
# ==============================================================================

# Application Settings
APP_NAME="TripMate AI"
APP_VERSION="1.0.0"
APP_ENV="development" # development | staging | production | testing
DEBUG=true
API_V1_PREFIX="/api/v1"

# Server Bindings
HOST="0.0.0.0"
PORT=8000

# Security & Secrets
SECRET_KEY="replace-with-a-secure-random-secret-key-at-least-32-chars-long"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS (Comma-separated or JSON list)
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# Logging
LOG_LEVEL="INFO" # DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_FORMAT="json" # json | text

# LLM Configuration
LLM_PROVIDER="mock" # openai | ollama | mock
OPENAI_API_KEY="" # Required if LLM_PROVIDER is openai
OPENAI_MODEL="gpt-4o"
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.1"
LLM_TIMEOUT=60
LLM_MAX_RETRIES=3

# Database Configuration (PostgreSQL)
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="tripmate"
POSTGRES_PASSWORD="tripmate_password"
POSTGRES_DB="tripmate_db"
# DATABASE_URL overrides individual settings if provided:
# DATABASE_URL="postgresql+asyncpg://tripmate:tripmate_password@localhost:5432/tripmate_db"

# RAG & Vector Store Configuration
VECTOR_STORE_TYPE="memory" # pgvector | memory
EMBEDDING_PROVIDER="mock" # openai | mock

# Agent Orchestration Settings
MAX_RETRY_COUNT=3
APPROVAL_TIMEOUT_HOURS=24

